# Never commit real credentials. Model availability must be checked with the hackathon account.
GEMINI_API_KEY=
GEMINI_MODEL=
TRIALFAIR_DATA_DIR=.trialfair
TRIALFAIR_MODE=live
TRIALFAIR_MAX_INTERPRETATION_TEXTS=20
# Optional: minimal|low|medium|high for Agent 1 interpretation calls; blank = model default.
TRIALFAIR_INTERPRETER_THINKING_LEVEL=
TRIALFAIR_MAX_MODEL_TURNS=12
TRIALFAIR_MAX_EXTERNAL_REQUESTS=16
TRIALFAIR_MAX_EVIDENCE_REQUESTS=2
TRIALFAIR_MAX_ADDITIONAL_ANALYSES=3
TRIALFAIR_RUN_TIMEOUT_SECONDS=150
